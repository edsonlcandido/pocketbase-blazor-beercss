@page "/"
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        // Equivale ao redirect '/' -> '/dashboard' do router do template Vue.
        // Caminho RELATIVO (sem barra inicial): é resolvido contra o <base href>,
        // que é "/" em dev e "/app/" em produção.
        Navigation.NavigateTo("dashboard", replace: true);
    }
}
