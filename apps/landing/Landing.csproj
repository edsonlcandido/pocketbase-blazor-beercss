<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Landing</RootNamespace>
    <AssemblyName>Landing</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    URL do web app injetada no build de produção.
    Padrão: "/app/" (o PocketBase serve o app em /app/).
    Override:  dotnet publish -p:WebAppUrl=https://app.exemplo.com
    O valor de DEV fica em wwwroot/appsettings.json.
  -->
  <PropertyGroup>
    <WebAppUrl Condition="'$(WebAppUrl)' == ''">/app/</WebAppUrl>
  </PropertyGroup>

  <!--
    Copia o build para pocketbase/pb_public (servido em /).
    O alvo em si vive no Directory.Build.targets da raiz.
  -->
  <PropertyGroup>
    <PocketBaseCopy>true</PocketBaseCopy>
    <PocketBasePublicDir>$(MSBuildThisFileDirectory)..\..\pocketbase\pb_public</PocketBasePublicDir>
  </PropertyGroup>

  <Target Name="WriteWebAppUrl" AfterTargets="Publish">
    <WriteLinesToFile
      File="$([System.IO.Path]::Combine('$(PublishDir)', 'wwwroot', 'appsettings.json'))"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="{ &quot;WebApp&quot;: { &quot;Url&quot;: &quot;$(WebAppUrl)&quot; } }" />
  </Target>

</Project>
