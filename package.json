{
    "name": "pocketbase-blazor-beercss-template",
    "version": "1.0.0",
    "description": "Template para projetos com PocketBase + Blazor WebAssembly + BeerCSS",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev:pb": "node scripts/pocketbase.js",
        "dev:landing": "dotnet watch run --project apps/landing",
        "dev:web": "dotnet watch run --project apps/web",
        "dev": "concurrently -k -n PB,LANDING,WEB -c blue,green,magenta \"npm:dev:pb\" \"npm:dev:landing\" \"npm:dev:web\"",
        "build:landing": "dotnet publish apps/landing -c Release -o apps/landing/publish",
        "build:web": "dotnet publish apps/web -c Release -o apps/web/publish",
        "copy:landing": "node scripts/copy-landing.js",
        "copy:app": "node scripts/copy-app.js",
        "build": "npm run build:landing && npm run copy:landing && npm run build:web && npm run copy:app",
        "preview": "node scripts/pocketbase.js"
    },
    "keywords": [
        "pocketbase",
        "blazor",
        "blazor-wasm",
        "beercss",
        "template"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
